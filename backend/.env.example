PORT=4000
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379
PDF_QUEUE_NAME=pdf-processing
EMAIL_QUEUE_NAME=email-dispatch
# Set to false when queue workers run in their own process (`npm run worker`)
RUN_WORKERS=true
# Server-wide defaults; each workspace can override them in Settings → API keys
GEMINI_API_KEY=<gemini_api_key>
RECALL_API_KEY=<recall_api_key>
# Encrypts workspace API keys at rest (32 bytes). Generate with: openssl rand -hex 32
# Without it, workspaces can't save their own keys. Don't change it once keys are saved.
SETTINGS_ENCRYPTION_KEY=<64_hex_chars>
# Required, min 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=<long_random_secret>
# Auth cookie: lax works when frontend and API share a site (app.x.com + api.x.com).
# Use none (HTTPS only) if they are on different sites.
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com
# Set to true (or a hop count) when running behind a reverse proxy / load balancer
# TRUST_PROXY=true
FRONTEND_URL=https://interview-standardizer.vercel.app
