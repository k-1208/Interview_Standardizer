# Copy to .env.docker and fill in. Used by docker-compose.yml:
#   docker compose --env-file .env.docker up -d --build

# --- Database (defaults to the bundled postgres container) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_product
# Uncomment to use an external DB (e.g. Supabase) instead of the bundled one:
# DATABASE_URL=postgresql://user:pass@host:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://user:pass@host:5432/postgres

# --- Public URLs ---
# Browser-facing URL of the API (baked into the frontend at build time)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
# Browser-facing URL of the frontend (CORS + links in emails)
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# --- Auth ---
# Required, min 32 chars; the API refuses to start with this placeholder.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# lax works when frontend and API share a site; use none (HTTPS only) for different sites
COOKIE_SAME_SITE=lax
# Set to true when a reverse proxy (Caddy/Nginx) sits in front of the API
# TRUST_PROXY=true

# --- Queues (Redis) ---
PDF_QUEUE_NAME=pdf-processing
EMAIL_QUEUE_NAME=email-dispatch

# --- Workspace API keys ---
# Encrypts the API keys admins save in Settings (32 bytes): openssl rand -hex 32
# Don't change it once keys are saved, or they can no longer be decrypted.
SETTINGS_ENCRYPTION_KEY=

# --- AI providers (server-wide defaults; workspaces can override in Settings) ---
GEMINI_API_KEY=
GROQ_API_KEY=
RECALL_API_KEY=

# --- S3 (resume storage) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
S3_BUCKET=

# --- SMTP (email worker) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# --- Host ports ---
# On a server behind a reverse proxy, bind to localhost only:
# BACKEND_PORT=127.0.0.1:4000
# FRONTEND_PORT=127.0.0.1:3000
